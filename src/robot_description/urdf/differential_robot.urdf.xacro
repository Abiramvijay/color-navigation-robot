<?xml version="1.0"?>
<robot name="differential_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Robot chassis -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.35 0.28 0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.35 0.28 0.10"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0142" ixy="0" ixz="0"
               iyy="0.0242" iyz="0" izz="0.0261"/>
    </inertial>
  </link>

  <!-- Left wheel -->
  <link name="left_wheel_link">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.000181" ixy="0" ixz="0"
               iyy="0.000313" iyz="0" izz="0.000181"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.16 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right wheel -->
  <link name="right_wheel_link">
    <visual>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.000181" ixy="0" ixz="0"
               iyy="0.000313" iyz="0" izz="0.000181"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.16 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear swivel caster mounting and fork -->
  <link name="caster_swivel_link">
    <!-- Vertical swivel stem -->
    <visual>
      <origin xyz="0 0 -0.0125"/>
      <geometry>
        <cylinder radius="0.008" length="0.025"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.0125"/>
      <geometry>
        <cylinder radius="0.008" length="0.025"/>
      </geometry>
    </collision>

    <!-- Two fork plates, leaving clearance around the wheel -->
    <visual>
      <origin xyz="-0.02 0.014 -0.025"/>
      <geometry>
        <box size="0.04 0.006 0.025"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="-0.02 0.014 -0.025"/>
      <geometry>
        <box size="0.04 0.006 0.025"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="-0.02 -0.014 -0.025"/>
      <geometry>
        <box size="0.04 0.006 0.025"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="-0.02 -0.014 -0.025"/>
      <geometry>
        <box size="0.04 0.006 0.025"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.000002" ixy="0" ixz="0"
               iyy="0.000002" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>

  <!-- Vertical swivel axis -->
  <joint name="caster_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_swivel_link"/>
    <origin xyz="-0.10 0 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Rear caster wheel -->
  <link name="caster_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.018"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.018"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00000916" ixy="0" ixz="0"
               iyy="0.00001563" iyz="0"
               izz="0.00000916"/>
    </inertial>
  </link>

  <!-- Horizontal wheel axle -->
  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_swivel_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="-0.04 0 -0.025" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Gazebo Fortress differential-drive system -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.32</wheel_separation>
      <wheel_radius>0.05</wheel_radius>

      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>

    </plugin>
  </gazebo>

  <!-- Gazebo Fortress joint-state publisher -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-joint-state-publisher-system.so"
      name="ignition::gazebo::systems::JointStatePublisher">

      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>caster_swivel_joint</joint_name>
      <joint_name>caster_wheel_joint</joint_name>

    </plugin>
  </gazebo>


  <!-- Front-facing camera -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.055 0.05 0.04"/>
      </geometry>
      <material name="camera_body">
        <color rgba="0.12 0.14 0.18 1"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0.032 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.012"/>
      </geometry>
      <material name="camera_lens">
        <color rgba="0.02 0.02 0.02 1"/>
      </material>
    </visual>

    <visual>
      <origin xyz="-0.005 0 -0.032"/>
      <geometry>
        <box size="0.025 0.04 0.025"/>
      </geometry>
      <material name="camera_mount">
        <color rgba="0.35 0.38 0.42 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.055 0.05 0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000017" ixy="0" ixz="0"
               iyy="0.000013" iyz="0" izz="0.000017"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.17 0 0.09" rpy="0 0 0"/>
  </joint>


  <!-- Gazebo Fortress camera sensor -->
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <pose>0.032 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>

      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
      </camera>

      <topic>/camera/image</topic>
    </sensor>
  </gazebo>

</robot>
